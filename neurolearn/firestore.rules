rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function requesterRole() {
      return request.auth != null && userDoc().exists
        ? userDoc().data.role
        : null;
    }

    function isOwnerOrLinkedStudent(studentUid) {
      return request.auth != null && (
        request.auth.uid == studentUid ||
        requesterRole() == 'teacher' ||
        (userDoc().exists && userDoc().data.linkedStudentIds is list && studentUid in userDoc().data.linkedStudentIds)
      );
    }

    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (resource.data.role == 'student' && requesterRole() in ['guardian', 'teacher'])
      );
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /sessions/{sessionId} {
      allow read: if isOwnerOrLinkedStudent(resource.data.studentId);
      allow write: if request.auth != null
        && request.resource.data.studentId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.studentId == request.auth.uid;
    }

    match /handwritingSamples/{sampleId} {
      allow read: if isOwnerOrLinkedStudent(resource.data.studentId);
      allow write: if request.auth != null
        && request.resource.data.studentId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.studentId == request.auth.uid;
    }

    match /analysisResults/{resultId} {
      allow read: if isOwnerOrLinkedStudent(resource.data.studentId);
      allow create: if request.auth != null;
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read: if isOwnerOrLinkedStudent(resource.data.studentId);
      allow write: if false;
      allow create: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
